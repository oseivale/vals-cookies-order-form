# Copy this file to .env (local dev) and set the same keys as environment
# variables in Netlify (Site settings → Environment variables) for deploys.

# --- Database (Postgres) ---
# A free Neon (https://neon.tech) database works well with Netlify Functions.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint you create at
# https://dashboard.stripe.com/webhooks -> add endpoint ->
# <your-site>/api/webhooks/stripe -> select "checkout.session.completed"
# and "checkout.session.expired"
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Nodemailer via Resend SMTP) ---
# From https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be on a domain you've verified in Resend
FROM_EMAIL="Sweet Batch Cookie Co. <orders@yourdomain.com>"

# --- Interac e-Transfer ---
# The email address customers should send their e-Transfer to
ETRANSFER_EMAIL=orders@yourdomain.com

# --- Admin dashboard ---
# Single shared password for /admin (protects the manual e-Transfer
# confirm/cancel actions and the order list)
ADMIN_PASSWORD=change-me
# Random string (32+ chars recommended) used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Site ---
# Your production URL, used for Stripe success/cancel redirects. Falls back
# to the request's own origin if unset, but setting it explicitly is safer.
SITE_URL=https://your-site.netlify.app
